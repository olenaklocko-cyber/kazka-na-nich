# Секрети й змінні середовища «Казка на ніч»
# ЦЕЙ файл — безпечний приклад (Commit). Справжні значення — у .env (lokah) і в
# дашборді Vercel (Settings → Environment Variables), туди потрапляють лише вони.
#
# Скопіюй:  cp .env.example .env   і впиши реальні ключі.
# Правило: .env ніколи не комітиться (перевірено у .gitignore).

# --- Генерація казок (Google Gemini) ---
LLM_API_KEY=AIza...

# --- Секрет для підпису Pro-токенів нашим сервером (будь-який довгий випадковий рядок) ---
PRO_SECRET=зміни-на-свій-випадковий-рядок

# --- LiqPay (оплата $4.99) ---
# Публічний ключ можна показувати, приватний — НІКОЛИ.
LIQPAY_PUBLIC_KEY=sandbox_xxx
LIQPAY_PRIVATE_KEY=тут-секретний-ключ

# --- Адреса сайту, куди LiqPay повертає після оплати ---
APP_URL=http://localhost:3002

# --- Порт локального/Docker-сервера (Vercel це ігнорує — там свій рантайм) ---
SERVER_PORT=3002
